<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <se.kth.lib.publikiosk.KioskWebView
            android:id="@+id/myWeb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/nav_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <!-- Kiosknavigeringen: visas när besökaren har lämnat webbappen (annan webbplats eller
             annan del av samma värd). Tillbaka och Hem; i mitten var besökaren är. -->
        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_back"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:minWidth="60dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Tillbaka"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/nav_text"
                app:backgroundTint="@android:color/white"
                app:strokeColor="@color/nav_border"
                app:strokeWidth="2dp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_lucide_chevron_left"
                app:iconTint="@color/nav_text"
                app:iconSize="26dp"/>

            <!-- Flera appar: en knapp per app (byggs i KioskChrome), hem-appen först -->
            <LinearLayout
                android:id="@+id/nav_apps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/nav_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:id="@+id/nav_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/nav_text"/>
                <TextView
                    android:id="@+id/nav_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textSize="14sp"
                    android:textColor="@color/nav_muted"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_home"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Hem"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/kth_blue"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_lucide_house"
                app:iconTint="@android:color/white"
                app:iconSize="26dp"/>
        </LinearLayout>

        <!-- Förstasidan (HOME_MODE=launcher): tjänsterna som besökaren väljer bland. Täcker webbsidan
             tills en tjänst öppnas. Byggs i LauncherScreen. -->
        <LinearLayout
            android:id="@+id/launcher_page"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/launcher_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/kth_navy">
                <ImageView
                    android:id="@+id/launcher_pattern"
                    android:layout_width="190dp"
                    android:layout_height="116dp"
                    android:layout_gravity="bottom|end"
                    android:scaleY="-1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitEnd"
                    android:src="@drawable/launcher_pattern"/>
                <LinearLayout
                    android:id="@+id/launcher_head_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp">
                    <ImageView
                        android:id="@+id/launcher_logo"
                        android:layout_width="82dp"
                        android:layout_height="92dp"
                        android:contentDescription="KTH"
                        android:src="@drawable/kth_logo_white"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="24dp">
                        <TextView
                            android:id="@+id/launcher_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/kth_light_blue"
                            android:textSize="21sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/launcher_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/white"
                            android:textSize="52sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/launcher_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/kth_light_blue"
                            android:textSize="21sp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/launcher_language"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/launcher_language_bg"
                    android:drawableStart="@drawable/ic_lucide_globe"
                    android:drawableTint="@android:color/white"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="18dp"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/launcher_tiles"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/launcher_bg"
                android:padding="24dp"/>

            <TextView
                android:id="@+id/launcher_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textColor="@color/nav_muted"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Egen felsida när en sida inte kan laddas (i stället för Chromiums) -->
        <LinearLayout
            android:id="@+id/error_page"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:color/white"
            android:padding="48dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/nav_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lucide_wifi_off"
                android:tint="@color/kth_blue"/>
            <TextView
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/kth_navy"/>
            <TextView
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="19sp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/nav_muted"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/error_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="14dp"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/kth_blue"
                    app:backgroundTint="@android:color/white"
                    app:strokeColor="@color/kth_blue"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/error_home"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/kth_blue"
                    app:cornerRadius="14dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Osynlig yta nere till höger: 5 snabba tryck öppnar menyn. Hög nog för att dess övre del
             ska ligga ovanför navigeringsfältets yta (där systemet fångar trycken) på alla skärmar.
             Ovanför kiosknavigeringen när den visas, så att den inte täcker Hem. -->
        <View
            android:id="@+id/trigger_area"
            android:layout_width="48dp"
            android:layout_height="96dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toTopOf="@id/nav_bar"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="0dp"/>

        <!-- Varning före tillbakagång: "Är du kvar?" med nedräkning -->
        <FrameLayout
            android:id="@+id/idle_warning"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/scrim"
            android:elevation="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/kiosk_card"
                android:padding="36dp"
                android:accessibilityLiveRegion="polite">
                <TextView
                    android:id="@+id/idle_count"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:gravity="center"
                    android:background="@drawable/kiosk_countdown"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:textColor="@color/kth_navy"/>
                <TextView
                    android:id="@+id/idle_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/kth_navy"/>
                <TextView
                    android:id="@+id/idle_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textSize="19sp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/nav_muted"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/idle_continue"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="22dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/kth_blue"
                    app:cornerRadius="16dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/idle_restart"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/kth_blue"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Blockerad länk: förklaring och QR-kod, så att besökaren kan fortsätta på sin telefon -->
        <FrameLayout
            android:id="@+id/blocked_sheet"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/scrim"
            android:elevation="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:layout_width="760dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/kiosk_sheet"
                android:padding="36dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/blocked_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/kth_navy"/>
                    <TextView
                        android:id="@+id/blocked_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="19sp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/nav_muted"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/blocked_close"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_marginTop="18dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textAllCaps="false"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@color/kth_blue"
                        app:cornerRadius="14dp"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/blocked_qr"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginStart="28dp"
                    android:padding="12dp"
                    android:background="@drawable/kiosk_qr_frame"/>
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start">
        <LinearLayout
            android:id="@+id/settings_drawer"
            android:layout_width="500dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:fitsSystemWindows="true">

            <TextView
                android:id="@+id/currentVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/resolutionTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upplösning: "
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_gravity="center"/>
            <!-- Anslutning till publicomtools -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="publicomtools"
                android:textSize="24sp"
                android:layout_marginTop="16dp"/>
            <TextView
                android:id="@+id/publicomtools_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:id="@+id/enroll_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adress"
                    android:textSize="16sp"/>
                <EditText
                    android:id="@+id/publicomtools_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="textUri"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inskrivningskod (från Teknik i publicomtools)"
                    android:textSize="16sp"/>
                <EditText
                    android:id="@+id/enroll_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="t ex K7QM-2XPA"
                    android:inputType="textCapCharacters|textNoSuggestions"/>
                <Button
                    android:id="@+id/enroll_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anslut till publicomtools"/>
            </LinearLayout>
            <Button
                android:id="@+id/fetch_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hämta inställningar nu"/>
            <Button
                android:id="@+id/disconnect_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Koppla från publicomtools"/>

            <TextView
                android:id="@+id/label_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inställningar"
                android:textSize="36sp"
                android:layout_marginBottom="20dp"/>
            <TextView
                android:id="@+id/managed_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inställningarna styrs från publicomtools och kan inte ändras här."
                android:textSize="16sp"
                android:textStyle="italic"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:id="@+id/label_inactivitytimeout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timeout för inaktivitet"
                android:textSize="16sp"
                android:layout_marginBottom="0dp"/>
            <EditText
                android:id="@+id/inactivitytimeout_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="Enter Timeout Value"
                android:inputType="number"
                android:text="10000"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/label_inactivitytimeoutweb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timeout för inaktivitet extern web"
                android:textSize="16sp"
                android:layout_marginBottom="0dp"/>
            <EditText
                android:id="@+id/inactivitytimeoutweb_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="Enter Timeout Value"
                android:inputType="number"
                android:text="10000"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/label_initialscale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initial Scale"
                android:textSize="16sp"
                android:layout_marginBottom="0dp"/>
            <EditText
                android:id="@+id/initialscale_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="Enter Scale Value"
                android:inputType="textUri"
                android:text="100"
                android:layout_marginBottom="10dp"/>
            <TextView
                android:id="@+id/label_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL för startsida"
                android:textSize="16sp"
                android:layout_marginBottom="0dp"/>
            <EditText
                android:id="@+id/url_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter URL"
                android:inputType="textUri"
                android:text="https://wagnerguide.com/c/kth/kth"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/label_allowedhosts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tillåtna webbplatser (utöver startsidan)"
                android:textSize="16sp"
                android:layout_marginBottom="0dp"/>
            <EditText
                android:id="@+id/allowedhosts_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="t ex kth.se, www.kth.se/biblioteket"
                android:inputType="textUri"
                android:layout_marginBottom="10dp"/>

            <CheckBox
                android:id="@+id/clearsession_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rensa inloggningar och cookies vid inaktivitet"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Orientation:" />

            <Spinner
                android:id="@+id/orientation_spinner"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"/>

            <CheckBox
                android:id="@+id/fullscreen_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable Full Screen"
                android:layout_marginBottom="20dp"/>

            <!-- Save Button -->
            <Button
                android:id="@+id/save_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spara" />

            <Button
                android:id="@+id/changePinButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Byt PIN"
                android:layout_gravity="center" />

            <Button
                android:id="@+id/showLogButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visa Log"
                android:layout_gravity="center" />

            <Button
                android:id="@+id/quitKiosk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lämna kioskläge"
                android:layout_gravity="center" />

            <!-- TextView to display log content -->
            <TextView
                android:id="@+id/logTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical"
                android:textSize="16sp"
                android:padding="16dp" />
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
